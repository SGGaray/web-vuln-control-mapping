{
  "name": "web-vuln-control-mapping",
  "version": "1.0.0",
  "private": true,
  "description": "Educational reference that maps common web vulnerabilities to technical signals, mitigations and security controls (OWASP Top 10, NIST SP 800-53, ISO/IEC 27001).",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/apply-csp.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "upload": "npm run build && wrangler versions upload"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
  }
}
