{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wvcm",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-21",
	// nodejs_compat: required by the OpenNext adapter.
	// global_fetch_strictly_public: part of the OpenNext template; server-side fetch() may only reach public hosts.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Required by `wrangler preview`. Empty on purpose: the Worker has no vars or
	// storage bindings to isolate, and assets/compatibility settings stay top-level.
	"previews": {}
}
