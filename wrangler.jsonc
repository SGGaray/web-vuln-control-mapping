{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wvcm",
	"compatibility_date": "2026-09-21",
	// Static site: there is no Worker script ("main"), so no request runs
	// application code and no compatibility flags are needed. Cloudflare serves
	// out/ (built by `npm run build`) as static assets, applying out/_headers
	// and out/_redirects.
	"assets": {
		"directory": "./out",
		// Paths that match no file get out/404.html with status 404.
		"not_found_handling": "404-page",
		// "/" serves index.html; "/index.html" redirects to "/" (Cloudflare's default).
		"html_handling": "auto-trailing-slash"
	},
	// Required by `wrangler preview`. Empty on purpose: there are no vars or
	// bindings to isolate, and the assets settings stay top-level.
	"previews": {}
}
